node_modules/
dist/
build/
.wrangler/

# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
wrangler.toml.local
.dev.vars

# Real financial data must never enter this repository.
# Note the leading slash: this is the folder at the top of the project where
# real statements are dropped. Without it, this would also swallow
# public/statements/, which is source code.
/statements/
*.pdf
*.csv
*.xls
*.xlsx

# Generated by `npm run vendor` from node_modules
public/vendor/
public/test-fixtures/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
